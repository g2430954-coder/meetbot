# ==========================================
# GHOST-meet | Environment Configuration
# ==========================================

# 1. TELEGRAM BOT SETTINGS
# Get your token from Telegram @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The exact Group ID where the bot is authorized to run (e.g., -1001234567890)
# To find your group ID, add @userinfobot to your Telegram group
ALLOWED_GROUP_ID=-1001234567890

# 2. GITHUB RUNNER DISPATCH SETTINGS (For Cloud Execution via Render + GitHub Actions)
# GitHub Personal Access Token (PAT) with 'repo' and 'workflow' permissions
PAT_TOKEN=ghp_your_github_personal_access_token_here

# GitHub Repository Details
GITHUB_OWNER=your_github_username
GITHUB_REPO=GHOST-meet

# 3. VNC & ACCESS SECURITY
# Password to access the live NoVNC browser viewer
VNC_PASSWORD=ghostsecretpass

# 4. OPTIONAL SERVER & BROWSER CONFIG
PORT=8080
# CHROME_PATH=/usr/bin/google-chrome-stable
